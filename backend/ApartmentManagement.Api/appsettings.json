{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID"
  },
  "Firebase": {
    "WebApiKey": "YOUR_FIREBASE_WEB_API_KEY"
  },
  "Jwt": {
    "Key": "YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS_LONG",
    "Issuer": "ApartmentHub",
    "Audience": "ApartmentHubClients",
    "ExpiryHours": 8
  },
  "SendGrid": {
    "ApiKey": "YOUR_SENDGRID_API_KEY",
    "SenderEmail": "YOUR_VERIFIED_SENDER_EMAIL@example.com",
    "SenderName": "Apartment Management"
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_SECRET_KEY"
  },
  "PythonAgentUrl": "http://localhost:8000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}